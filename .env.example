# Copy to .env and fill in. .env is gitignored. Quote values with spaces.
# daily_art.py reads it on start. `make frame-compile` and `make frame-upload` pass it to ESPHome.

# --- Server (frame/daily_art.py) ---

# Port for the board and the web app.
FRAME_PORT=8765
# The board sleeps from FRAME_BEDTIME to FRAME_WAKE and checks every FRAME_POLL seconds in between.
# A check costs about 0.05 mAh, see frame/README.md. The board reads FRAME_POLL too, reflash after a change.
FRAME_WAKE=06:00
FRAME_BEDTIME=23:00
FRAME_POLL=600
# Where today's painting, its details and the last battery reading are kept.
FRAME_STATE_DIR=~/.local/share/spectra6-frame
# Largest upload the web app takes, in MB.
FRAME_MAX_UPLOAD_MB=40
# Path to the spectra6 binary. Empty looks it up on PATH, then in ~/bin.
SPECTRA6_BIN=

# --- Board (frame/ee02.yaml) ---

# The computer running daily_art.py, as the board reaches it.
FRAME_SERVER=http://192.168.1.10:8765
FRAME_WIFI_SSID="your network"
FRAME_WIFI_PASSWORD="your password"
# A fixed address saves DHCP on every check. Pick one outside the router's DHCP pool.
FRAME_IP=192.168.1.20
FRAME_GATEWAY=192.168.1.1
FRAME_SUBNET=255.255.255.0
# Hostname, also used for flashing over wifi as <name>.local.
FRAME_NAME=art-frame
# 270 or 90, depending on which way up the frame hangs.
FRAME_ROTATION=270
# Battery divider ratio. Measure the pack with a multimeter and adjust if the web app reads it wrong.
FRAME_BATTERY_MULTIPLY=2.07
# Serial port for `make frame-upload`. `ls /dev/cu.usbmodem*` shows it. Or <FRAME_NAME>.local over wifi.
FRAME_DEVICE=/dev/cu.usbmodem101
